---
import Logo from './Logo.astro';
import { site, nav } from '../data/site.js';

interface Props {
  active?: string;
}
const { active = '' } = Astro.props;
---
<header class="hdr" data-header>
  <!-- Utility bar: collapses to zero height past 60px of scroll -->
  <div class="hdr__util">
    <div class="hdr__util-inner">
      <span class="hdr__util-area">{site.serviceArea}</span>
      <span class="hdr__util-right">
        <span>Free written scope in 48 hrs</span>
        <span class="hdr__util-dim">Family-run since {site.founded}</span>
      </span>
    </div>
  </div>

  <div class="hdr__main">
    <!-- Four grid children, not three nested groups. On wide screens they sit
         in one row (logo · nav · phone · CTA); below 880px they re-flow into
         two short rows without any change to the markup. -->
    <div class="hdr__inner">
      <!-- Wrapped rather than given the class directly: Astro scopes styles
           per component, so a class from here would not match an element
           rendered inside Logo. -->
      <div class="hdr__logo"><Logo href="/" /></div>

      <nav class="hdr__nav" aria-label="Main">
        {nav.map((item) => (
          <a
            href={item.href}
            class="hdr__link"
            aria-current={active === item.key ? 'page' : undefined}
          >
            {item.label}
            {active === item.key && <span class="hdr__underline"></span>}
          </a>
        ))}
      </nav>

      <a href={site.phoneHref} class="hdr__phone">{site.phone}</a>
      <a href="/estimate/" class="btn btn--primary hdr__cta" data-magnetic>Free estimate →</a>
    </div>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 80;
    font-family: var(--font-body);
  }

  .hdr__util {
    background: var(--ink);
    color: #9AA3B2;
    overflow: hidden;
    max-height: 60px;
    opacity: 1;
    transition: max-height 480ms var(--ease), opacity 300ms ease;
  }
  .hdr.is-scrolled .hdr__util { max-height: 0; opacity: 0; }

  .hdr__util-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 24px;
    padding: 10px var(--gutter);
    font-size: 13.5px;
    line-height: 1.6;
    font-weight: 500;
    letter-spacing: 0.004em;
  }
  .hdr__util-area { color: var(--light-grey); }
  .hdr__util-right { display: flex; gap: 22px; flex-wrap: wrap; }
  .hdr__util-dim { color: #6E7A8C; }

  .hdr__main {
    background: var(--paper);
    border-bottom: 1px solid var(--hairline);
    transition: box-shadow 400ms ease;
  }
  .hdr.is-scrolled .hdr__main { box-shadow: 0 12px 40px -28px rgba(11, 13, 16, .5); }

  .hdr__inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    grid-template-areas: "logo nav phone cta";
    align-items: center;
    column-gap: 16px;
    min-height: 74px;
  }
  .hdr__logo  { grid-area: logo; min-width: 0; }
  .hdr__nav   { grid-area: nav; justify-self: center; }
  .hdr__phone { grid-area: phone; }
  .hdr__cta   { grid-area: cta; }

  .hdr__nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    min-width: 0;
    gap: clamp(14px, 1.9vw, 30px);
    font-size: 14.5px;
    font-weight: 500;
  }
  .hdr__link {
    position: relative;
    display: block;
    color: var(--ink);
    padding: 25px 0;
    transition: color 260ms var(--ease);
  }
  .hdr__link:hover { color: var(--signal); }
  .hdr__underline {
    position: absolute;
    left: 0; right: 0;
    bottom: 22px;
    height: 2px;
    background: var(--signal);
  }

  .hdr__phone {
    color: var(--ink);
    font-size: 15.5px;
    font-weight: 600;
    white-space: nowrap;
    transition: color 260ms var(--ease);
  }
  .hdr__phone:hover { color: var(--signal); }
  .hdr__cta { padding: 14px 22px; white-space: nowrap; }

  /* ---------------------------------------------------------------------
     Below 880px all four items stop fitting on one line. Rather than let
     them wrap into three stacked rows — which made the sticky header a
     third of a phone screen — they re-flow into two short rows:

        logo                    [ Free estimate ]
        Services Projects About        1-877-…

     Both lead paths stay visible at every scroll position, which is the
     point of the header on this site.
     --------------------------------------------------------------------- */
  @media (max-width: 880px) {
    .hdr__inner {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        "logo  cta"
        "nav   phone";
      min-height: 0;
      column-gap: 0;
      padding-top: 11px;
    }
    /* Both cells stretch and the column gap is zero, so their top borders
       meet and read as one rule across the header rather than two stubs.
       Row-one spacing is restored by a margin on the button instead. */
    .hdr__nav   { justify-self: stretch; min-width: 0; }
    .hdr__phone { justify-self: stretch; min-width: 0; }
    .hdr__cta   { margin-left: 12px; }

    /* align-self: stretch matters — the grid centres items by default, and
       the nav cell is taller than the phone cell, so their top borders would
       sit at different heights and the rule would look broken. */
    .hdr__nav, .hdr__phone {
      border-top: 1px solid var(--hairline);
      margin-top: 11px;
      align-self: stretch;
    }
    .hdr__nav { gap: 20px; flex-wrap: nowrap; }
    .hdr__link { padding: 11px 0; font-size: 14px; }
    .hdr__underline { bottom: 8px; }
    .hdr__phone {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      font-size: 14.5px;
    }
    .hdr__cta { padding: 12px 16px; font-size: 14px; }

    /* One line of utility copy is enough on a phone. */
    .hdr__util-right { display: none; }
    .hdr__util-inner { padding: 7px var(--gutter); font-size: 13px; }
  }

  /* Smallest phones. Sized so the two rows still fit when the Instrument Sans
     webfont has not loaded and a wider system fallback is standing in. */
  @media (max-width: 400px) {
    .hdr__nav   { gap: 12px; }
    .hdr__link  { font-size: 13px; }
    .hdr__phone { font-size: 13px; }
    .hdr__cta   { padding: 11px 10px; font-size: 13px; }
  }
</style>
