---
import Mark from './Mark.astro';

interface Props {
  variant?: 'default' | 'reversed';
  href?: string | null;
  class?: string;
}
const { variant = 'default', href = '/', class: className = '' } = Astro.props;
const reversed = variant === 'reversed';
const Tag = href ? 'a' : 'div';
---
<Tag
  class:list={['logo', className]}
  {...href ? { href, 'aria-label': 'Northern Soul Renovation — home' } : {}}
>
  <Mark variant={variant} height={30} />
  <span class="logo__text">
    <span class="logo__name" style={reversed ? 'color:#FFFFFF' : 'color:#0B0D10'}>Northern Soul</span>
    <span class="logo__sub" style={reversed ? 'color:#8B93A3' : 'color:#6E7686'}>Renovation</span>
  </span>
</Tag>

<style>
  .logo {
    display: flex;
    align-items: center;
    gap: 8px;
    color: inherit;
  }
  .logo__text { display: block; }
  .logo__name {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 118%;
    font-size: 15px;
    letter-spacing: 0.1em;
    line-height: 1.1;
    text-transform: uppercase;
    white-space: nowrap;
  }
  /* The one intentional letter-spaced micro-label on the site. It is a
     logotype detail, not a label style — do not reuse it elsewhere. */
  .logo__sub {
    display: block;
    font-family: var(--font-body);
    font-size: 9.5px;
    font-weight: 500;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    margin-top: 4px;
  }

  /* On a phone the lockup shares its row with the estimate button, so it
     gives up a little width. The 0.42em tracking on "Renovation" is a
     logotype detail and is kept. */
  @media (max-width: 880px) {
    .logo { gap: 7px; }
    .logo__name { font-size: 13.5px; letter-spacing: 0.08em; }
    .logo__sub  { font-size: 8.5px; letter-spacing: 0.34em; margin-top: 3px; }
  }
  @media (max-width: 400px) {
    .logo { gap: 6px; }
    .logo__name { font-size: 12px; letter-spacing: 0.05em; }
    .logo__sub  { font-size: 7.5px; letter-spacing: 0.28em; }
  }
</style>
