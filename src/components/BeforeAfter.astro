---
interface Props {
  beforeSrc: string;
  beforeAlt: string;
  afterSrc: string;
  afterAlt: string;
  /** Starting split, 2–98. */
  start?: number;
}
const { beforeSrc, beforeAlt, afterSrc, afterAlt, start = 52 } = Astro.props;
---
<div
  class="ba wipe"
  data-before-after
  style={`--split:${start}`}
>
  <!-- After photo is the base layer -->
  <img class="ba__img" src={afterSrc} alt={afterAlt} loading="lazy" decoding="async" width="1920" height="1080" />

  <!-- Before photo sits on top, clipped from the right by the split -->
  <div class="ba__before">
    <img class="ba__img" src={beforeSrc} alt={beforeAlt} loading="lazy" decoding="async" width="1920" height="1080" />
  </div>

  <div class="ba__divider" aria-hidden="true">
    <span class="ba__handle">↔</span>
  </div>

  <span class="ba__chip ba__chip--left">Before</span>
  <span class="ba__chip ba__chip--right">After</span>

  <!-- Keyboard- and screen-reader-accessible control for the same state -->
  <label class="ba__sr">
    Reveal the before photo
    <input type="range" min="2" max="98" value={start} data-ba-range />
  </label>
</div>

<style>
  .ba {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--ink);
    cursor: ew-resize;
    touch-action: pan-y;
    user-select: none;
  }
  .ba__img { width: 100%; height: 100%; object-fit: cover; }
  .ba__before {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--split) * 1%) 0 0);
  }
  .ba__divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--split) * 1%);
    width: 2px;
    background: #fff;
    pointer-events: none;
  }
  .ba__handle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 52px;
    height: 52px;
    background: #fff;
    color: var(--ink);
    display: grid;
    place-items: center;
    font-size: 20px;
    font-weight: 500;
    animation: nsr-pulse 2600ms ease-in-out infinite;
  }
  .ba__chip {
    position: absolute;
    bottom: 18px;
    padding: 8px 14px;
    font-size: 15px;
    font-weight: 600;
    pointer-events: none;
  }
  .ba__chip--left  { left: 18px;  background: rgba(11, 13, 16, .72); color: var(--light-grey); }
  .ba__chip--right { right: 18px; background: var(--signal);          color: #fff; }

  /* The range input is the accessible fallback: visually hidden, still focusable. */
  .ba__sr {
    position: absolute;
    width: 1px; height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .ba__sr:focus-within {
    position: absolute;
    left: 18px; bottom: 80px;
    width: auto; height: auto;
    clip: auto;
    background: rgba(11,13,16,.9);
    color: #fff;
    padding: 10px 14px;
    font-size: 13.5px;
    z-index: 3;
  }

  @media (prefers-reduced-motion: reduce) {
    .ba__handle { animation: none; }
  }
</style>

<script>
  /* Hover-scrub and pointer-drag, clamped 2–98. The split lives in a CSS
     custom property so nothing else has to be recalculated. */
  document.querySelectorAll('[data-before-after]').forEach((el) => {
    const node = el as HTMLElement;
    const range = node.querySelector('[data-ba-range]') as HTMLInputElement | null;
    let dragging = false;

    const set = (pct: number) => {
      const clamped = Math.max(2, Math.min(98, pct));
      node.style.setProperty('--split', String(clamped));
      if (range) range.value = String(Math.round(clamped));
    };

    const fromEvent = (e: PointerEvent | MouseEvent) => {
      const r = node.getBoundingClientRect();
      set(((e.clientX - r.left) / r.width) * 100);
    };

    node.addEventListener('mousemove', (e) => { if (!dragging) fromEvent(e); });
    node.addEventListener('pointerdown', (e) => {
      dragging = true;
      node.setPointerCapture(e.pointerId);
      fromEvent(e);
    });
    node.addEventListener('pointermove', (e) => { if (dragging) fromEvent(e); });
    node.addEventListener('pointerup', (e) => {
      dragging = false;
      try { node.releasePointerCapture(e.pointerId); } catch {}
    });
    node.addEventListener('pointercancel', () => { dragging = false; });

    range?.addEventListener('input', () => set(Number(range.value)));
  });
</script>
