---
import { site } from '../data/site.js';

interface Props {
  heading: string;
  body?: string;
  cta?: string;
  href?: string;
}
const {
  heading,
  body = 'Tell us the room, the rough budget and the timing. You get a written scope back within 48 hours — no obligation, no sales visit.',
  cta = 'Start my estimate →',
  href = '/estimate/',
} = Astro.props;
---
<section class="cta-band bg-signal">
  <div class="container cta-band__inner">
    <div class="reveal">
      <h2 class="display h2-md cta-band__head">{heading}</h2>
      <p class="cta-band__body">{body}</p>
    </div>
    <div class="cta-band__actions reveal" style="--reveal-delay:90ms">
      <a href={href} class="btn btn--on-blue" data-magnetic>{cta}</a>
      <a href={site.phoneHref} class="cta-band__phone">{site.phone}</a>
    </div>
  </div>
</section>

<style>
  .cta-band { padding: var(--section-y) 0; }
  .cta-band__inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: clamp(28px, 4vw, 64px);
    align-items: end;
  }
  .cta-band__head { color: #fff; max-width: 14ch; }
  .cta-band__body {
    margin-top: 20px;
    font-size: clamp(16px, 1.35vw, 19px);
    line-height: 1.65;
    color: var(--on-blue);
    max-width: 46ch;
    text-wrap: pretty;
  }
  .cta-band__actions {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  .cta-band__phone {
    font-family: var(--font-display);
    font-stretch: 115%;
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(22px, 2.4vw, 32px);
    color: #fff;
    transition: color 260ms var(--ease);
  }
  .cta-band__phone:hover { color: var(--ink); }
</style>
