---
import Logo from './Logo.astro';
import { site, footerServices, footerCompany } from '../data/site.js';
const year = new Date().getFullYear();
---
<footer class="ftr">
  <div class="ftr__inner">
    <div class="ftr__cols">
      <div class="ftr__col">
        <Logo variant="reversed" href={null} class="ftr__logo" />
        <p class="ftr__blurb">{site.boilerplate}</p>
        <div class="ftr__social">
          <a href={site.instagram} class="ftr__social-link" rel="noopener">Instagram</a>
          <a href={site.facebook} class="ftr__social-link" rel="noopener">Facebook</a>
        </div>
      </div>

      <div class="ftr__col">
        <h2 class="ftr__head">Services</h2>
        <div class="ftr__links">
          {footerServices.map((l) => <a href={l.href} class="ftr__link">{l.label}</a>)}
        </div>
      </div>

      <div class="ftr__col">
        <h2 class="ftr__head">Company</h2>
        <div class="ftr__links">
          {footerCompany.map((l) => <a href={l.href} class="ftr__link">{l.label}</a>)}
        </div>
      </div>

      <div class="ftr__col">
        <h2 class="ftr__head">Get in touch</h2>
        <a href={site.phoneHref} class="ftr__phone">{site.phone}</a>
        <div class="ftr__meta">
          <a href={`mailto:${site.email}`} class="ftr__link">{site.email}</a>
          <span>{site.hours}</span>
          <span>{site.location}</span>
        </div>
        <a href="/estimate/" class="btn btn--primary ftr__book">Book a consult →</a>
      </div>
    </div>

    <!-- Oversized wordmark, barely above the ink ground, clipped by the container -->
    <div class="ftr__wordmark-wrap" aria-hidden="true">
      <div class="ftr__wordmark">Northern Soul</div>
    </div>

    <div class="ftr__legal">
      <span>© {year} {site.legalName}</span>
      <span>{site.tagline}</span>
      <span>Licensed &amp; insured · WorkSafeBC covered</span>
    </div>
  </div>
</footer>

<style>
  .ftr {
    background: var(--ink);
    color: var(--light-grey);
    font-family: var(--font-body);
  }
  .ftr__inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: clamp(56px, 7vw, 96px) var(--gutter) 0;
  }
  .ftr__cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: clamp(32px, 4vw, 56px);
    align-items: start;
  }
  .ftr__col { min-width: 0; }

  .ftr__logo { margin-bottom: 20px; }
  .ftr__blurb {
    font-size: 15px;
    line-height: 1.65;
    color: var(--dim-grey);
    max-width: 32ch;
    text-wrap: pretty;
  }
  .ftr__social { display: flex; gap: 10px; margin-top: 24px; flex-wrap: wrap; }
  .ftr__social-link {
    border: 1px solid #23262E;
    color: var(--light-grey);
    padding: 9px 14px;
    font-size: 14.5px;
    font-weight: 500;
    transition: border-color 300ms var(--ease), color 300ms var(--ease);
  }
  .ftr__social-link:hover { border-color: var(--signal); color: #fff; }

  .ftr__head {
    margin: 0 0 20px;
    font-size: 15px;
    font-weight: 600;
    color: #fff;
    font-family: var(--font-body);
    letter-spacing: 0;
    text-transform: none;
  }
  .ftr__links { display: flex; flex-direction: column; gap: 12px; font-size: 15px; }
  .ftr__link { color: var(--light-grey); transition: color 260ms var(--ease); }
  .ftr__link:hover { color: #fff; }

  .ftr__phone {
    display: block;
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(20px, 2.2vw, 26px);
    color: #fff;
    margin-bottom: 14px;
    transition: color 260ms var(--ease);
  }
  .ftr__phone:hover { color: var(--beam); }
  .ftr__meta {
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 15px;
    color: var(--dim-grey);
  }
  .ftr__book { display: inline-block; margin-top: 24px; }

  .ftr__wordmark-wrap { margin-top: clamp(48px, 6vw, 80px); overflow: hidden; }
  .ftr__wordmark {
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(40px, 12.5vw, 190px);
    line-height: 0.86;
    letter-spacing: -0.02em;
    color: #14171D;
    white-space: nowrap;
    user-select: none;
  }

  .ftr__legal {
    border-top: 1px solid var(--hairline-dark);
    margin-top: 28px;
    padding: 22px 0 30px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    justify-content: space-between;
    font-size: 14px;
    color: #5D6470;
  }
</style>
